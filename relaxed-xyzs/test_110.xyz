/
&SYSTEM
   ibrav            = 0
   nbnd             = 67
   tot_charge       = 0.0
   ecutwfc          = 40.0
   ecutrho          = 600
   occupations      = 'smearing'
   degauss          = 0.01
   smearing         = 'cold'
